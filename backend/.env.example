# Local server
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8787
# Comma-separated extra web origins for development. chrome-extension:// origins are handled separately.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Free/local AI: deterministic (no model), or ollama
AI_PROVIDER=deterministic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Google Cloud OAuth "Web application" client.
# Keep these values in backend/.env only—never in extension source.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/oauth2/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required before OAuth tokens can be stored. Exactly 64 hex characters.
TOKEN_ENCRYPTION_KEY=

# Local private data location (relative to backend/ unless absolute)
DATA_DIR=.data
MAX_PDF_MB=8
